# Copy to .env and fill in from Customer Area (test):
# Developers > API credentials > your ws_ user
ADYEN_API_KEY=
ADYEN_CLIENT_KEY=
ADYEN_MERCHANT_ACCOUNT=
# Developers > Webhooks > Standard webhook > HMAC key (hex)
ADYEN_HMAC_KEY=
# Checkout API base for the test environment. Do not add a trailing slash.
ADYEN_CHECKOUT_URL=https://checkout-test.adyen.com/v71
# Where Adyen sends the shopper back after a redirect payment method
RETURN_URL=http://localhost:8080/redirect
PORT=8080
